{
  "name": "infinity-live-quiz",
  "version": "4.0.0",
  "description": "Infinity Live Quiz - Local Web App",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "predev": "node scripts/cleanup.js",
    "prestart": "node scripts/cleanup.js",
    "start": "cd server && npm start",
    "dev": "cd server && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:client": "cd client && npm run build",
    "dist:windows": "node scripts/create-windows-package.js",
    "install:all": "npm install --no-package-lock && cd server && npm install --no-package-lock && cd ../client && npm install --no-package-lock",
    "debug": "cd server && npm run debug",
    "db": "cd server && npm run db"
  },
  "keywords": [
    "youtube",
    "live-chat",
    "quiz",
    "competition",
    "socket.io",
    "react",
    "local"
  ],
  "author": "Wizklub",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  }
}
